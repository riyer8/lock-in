# Local coach backend. Copy to `.env` in the repo root.
# The extension never loads this file. The Python process on this machine does.

# Required for /api/coach, /api/plan, /api/adapt, and /api/coach/chat.
# Get a key from https://platform.openai.com/api-keys
OPENAI_DEVELOPER_KEY=

# Optional. Default: gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-luna

# Optional listen address. Default: 127.0.0.1
# Keep this loopback. The backend only allows chrome-extension:// origins.
COACH_HOST=127.0.0.1

# Optional listen port. Default: 8787
# The unpacked extension is hardcoded to http://127.0.0.1:8787 in
# manifest.json host_permissions and src/newtab/newtab.js.
# Changing this without matching those files means the new tab cannot reach the server.
COACH_PORT=8787

# Optional. 32-character unpacked extension id (a-p only).
# npm run setup-coach tries to discover LOCK IN from Chrome profile prefs.
# Set this if that lookup fails after you load the unpacked extension.
# LOCK_IN_EXTENSION_ID=
